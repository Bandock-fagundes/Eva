# HTTPS automático (Let's Encrypt / ZeroSSL) para https://{$DOMINIO}
# DOMINIO, EVA_PC_VNC_SENHA e PERMITIR_IFRAME_DE vêm do .env (o instalar.sh preenche).

{$DOMINIO} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}

	# Agente do PC (a própria rota exige o token EVA_PC_TOKEN)
	handle_path /pc/* {
		reverse_proxy desktop:8765
	}

	# Conexão ao vivo da tela (WebSocket do noVNC): só entra quem sabe a senha, que vai no caminho
	handle /vnc/ws/{$EVA_PC_VNC_SENHA} {
		rewrite * /websockify
		reverse_proxy desktop:6080
	}
	handle /vnc/ws/* {
		respond "Acesso negado." 403
	}
	handle /vnc/websockify {
		respond "Acesso negado." 403
	}

	# Páginas do noVNC (código aberto, sem nada secreto). Pode aparecer dentro do app da Eva.
	handle_path /vnc/* {
		header Content-Security-Policy "frame-ancestors 'self' {$PERMITIR_IFRAME_DE}"
		reverse_proxy desktop:6080
	}
	redir /vnc /vnc/ 308

	# A Eva (só se o serviço "eva" estiver ligado nesta máquina)
	handle {
		reverse_proxy eva:8000
	}

	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html><html lang="pt-BR"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
			<title>Computador da Eva</title>
			<body style="margin:0;min-height:100vh;display:grid;place-items:center;background:#0b0d12;color:#e8eaf0;font:16px system-ui,sans-serif;text-align:center">
			<div style="max-width:520px;padding:24px"><h1 style="color:#8b7cff;letter-spacing:4px">E.V.A.</h1>
			<p>✅ O <b>computador da Eva</b> está ligado nesta máquina.</p>
			<p style="color:#8b94a8">O app da Eva não está rodando aqui (ou ainda está iniciando). Se ela roda no Render, está tudo certo: abra o app de lá.</p></div>
			HTML 200
	}
}
