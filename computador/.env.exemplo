# Gerado pelo instalar.sh — normalmente você NÃO precisa mexer aqui.
# Se editar à mão, rode de novo:  sudo bash instalar.sh   (ou: docker compose up -d)

# Endereço público (IP com traços + .sslip.io), ex.: 129-146-10-20.sslip.io
DOMINIO=
# Token que a Eva usa para controlar o computador (cole na Eva como EVA_PC_TOKEN)
EVA_PC_TOKEN=
# Senha da tela ao vivo (cole na Eva como EVA_PC_VNC_SENHA)
EVA_PC_VNC_SENHA=
# Resolução da tela virtual
EVA_PC_RESOLUCAO=1280x800
# Deixar a Eva usar "sudo" no terminal do computador (instalar programas): sim | nao
EVA_PC_SUDO=nao
# Memória máxima do computador
EVA_PC_MEMORIA=6g
# Sites que podem mostrar a tela ao vivo dentro deles (o app da Eva). Separe por espaço.
PERMITIR_IFRAME_DE=https://*.onrender.com http://localhost:8000 http://127.0.0.1:8000

# ===== Só se a Eva também rodar nesta máquina (COM_EVA=sim) =====
COM_EVA=nao
EVA_LLM_API_KEY=
EVA_SENHA=
EVA_USER_NAME=Gabriel
# vazio = banco SQLite guardado no volume da máquina; ou cole a string do Neon (postgresql://...)
DATABASE_URL=
