# ===== CÉREBRO DA EVA (qualquer API compatível com OpenAI) =====
# Opção 1 (grátis pra começar): Google Gemini -> pegue a chave em https://aistudio.google.com/apikey
EVA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVA_LLM_API_KEY=cole_sua_chave_aqui
EVA_LLM_MODEL=gemini-3.8-flash

# Opção 2: OpenAI
# EVA_LLM_BASE_URL=https://api.openai.com/v1
# EVA_LLM_MODEL=gpt-4.1-mini

# Opção 3: 100% local e grátis com Ollama (precisa de PC bom)
# EVA_LLM_BASE_URL=http://localhost:11434/v1
# EVA_LLM_API_KEY=ollama
# EVA_LLM_MODEL=qwen2.5:7b

# Opção 4: OpenRouter (vários modelos, incluindo Claude)
# EVA_LLM_BASE_URL=https://openrouter.ai/api/v1
# EVA_LLM_MODEL=anthropic/claude-sonnet-4

# ===== GERAL =====
EVA_USER_NAME=Gabriel
EVA_MAX_STEPS=15
# false = você VÊ o navegador da Eva abrindo na tela
EVA_BROWSER_HEADLESS=false
EVA_PORT=8000
