# ===== CÉREBRO DA EVA (API compatível com OpenAI) =====
# Google Gemini (grátis): pegue a chave em https://aistudio.google.com/apikey
EVA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EVA_LLM_API_KEY=cole_sua_chave_aqui
EVA_LLM_MODEL=gemini-3.8-flash
# Se esse modelo não existir para a sua chave, a Eva tenta sozinha:
# gemini-3.6-flash -> gemini-3.5-flash-lite -> gemini-3.1-flash-lite
# (opcional) mais modelos reserva, separados por vírgula:
# EVA_LLM_FALLBACKS=

# ===== ACESSO =====
# Senha para entrar no app (OBRIGATÓRIA na nuvem; sem ela a Eva só abre em 127.0.0.1)
EVA_SENHA=
EVA_USER_NAME=Gabriel

# ===== BANCO =====
# Vazio = SQLite local (data/eva.db). Na nuvem: string do Neon (postgresql://...)
DATABASE_URL=

# ===== OPCIONAIS (os padrões já funcionam) =====
# EVA_MAX_STEPS=25
# EVA_LLM_TIMEOUT=90
# EVA_BROWSER_HEADLESS=false      # false = você VÊ o navegador abrindo (só no PC)
# EVA_BROWSER_OCIOSO_MIN=5        # fecha o navegador depois de 5 min parado
# EVA_PORT=8000
